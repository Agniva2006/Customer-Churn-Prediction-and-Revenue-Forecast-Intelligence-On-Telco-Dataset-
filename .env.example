# ==============================
# Environment Configuration
# ==============================
# API URL for Streamlit frontends to connect to FastAPI backend
API_URL=http://127.0.0.1:8000

# Server Ports
API_PORT=8000
DASHBOARD_PORT=8501

# Python Version (for Render / Heroku)
PYTHON_VERSION=3.10.12

# Model Configuration
MODEL_PATH=models/churn_pipeline.pkl
DEFAULT_THRESHOLD=0.15

# Business Parameters
RETENTION_COST=500
SAVE_RATE=0.6
DEFAULT_CLV=850

# Monte Carlo Simulation Defaults
MC_N_CUSTOMERS=7043
MC_AVG_REVENUE=6000
MC_CHURN_MEAN=0.27
MC_CHURN_STD=0.05
MC_N_SIMULATIONS=5000

# Authentication Security
AUTH_TOKEN_TTL_HOURS=72
AUTH_PBKDF2_ITERATIONS=200000
